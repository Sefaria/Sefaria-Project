{
  "_doc": "Mapping for scripts/darkmode/tokenize-css.js. Keys under colors are canonical colours (#rrggbb or rgba(r,g,b,a)); property classes are text, bg, border, shadow, svg, other. rules are context overrides (sel = regex on the selector, first match wins). legacy holds 1:1 tokens with a reviewed dark value.",
  "targets": [
    "s2.css",
    "static.css",
    "common.css",
    "keyboard.css",
    "common-components.css",
    "popover.scss",
    "common-component.scss",
    "auth.scss",
    "fonts.scss",
    "themes/library-theme.css",
    "themes/sheets-theme.css",
    "unbounce-banner.css"
  ],
  "ratchetExempt": {
    "theme-tokens.css": "token definitions",
    "color-palette.css": "raw palette definitions"
  },
  "skip": [
    {
      "sel": "\\.(dark|sepia)(?![\\w-])",
      "reason": "legacy reader .dark/.sepia theme (no UI sets it)"
    },
    {
      "sel": "^\\.color \\.",
      "reason": "legacy reader colour picker swatches"
    },
    {
      "sel": "\\.linkerAdmin|\\.mutc(?![\\w-])",
      "reason": "staff-only linker admin UI"
    },
    {
      "sel": "span\\.ref-link-color-",
      "reason": "dead selectors (no JS reference)"
    },
    {
      "sel": "#visualGardenPage",
      "reason": "visual garden page (dc.js charts, legacy)"
    },
    {
      "atRule": "^@media print",
      "reason": "print styles stay light"
    }
  ],
