/*
 * POC icon cleanup: Font Awesome glyphs drawn with Lucide.
 * Generated by scripts/icons/build_lucide_icons.py — edit the template, not this file.
 *
 * Each mapped .fa-* glyph keeps its markup but paints a Lucide mask in place of the font glyph.
 * The mask is filled with currentColor, so the icon follows the text color of its parent
 * (icon-default on body text, icon-inverse inside primary buttons).
 */
.fa::before {
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
}
/* RULES */
.fa[class*="fa-"]:is(
  .fa-check, .fa-external-link, .fa-link, .fa-file-o, .fa-file-text-o, .fa-comment, .fa-comment-o,
  .fa-times, .fa-times-circle, .fa-pencil, .fa-lock, .fa-unlock, .fa-chevron-left, .fa-chevron-right,
  .fa-bars, .fa-caret-down, .fa-caret-up, .fa-caret-right, .fa-caret-left, .fa-angle-down, .fa-angle-up,
  .fa-angle-left, .fa-angle-right, .fa-plus, .fa-eye, .fa-upload, .fa-trash-o, .fa-share-alt,
  .fa-search-plus, .fa-search-minus, .fa-picture-o, .fa-list-ul, .fa-list-ol, .fa-language, .fa-home,
  .fa-gear, .fa-floppy-o, .fa-clipboard, .fa-ban, .fa-header, .fa-wrench, .fa-envelope-o
)::before {
  content: "";
  display: inline-block;
  width: 1em;
  height: 1em;
  vertical-align: -0.125em;
  background-color: currentColor;
}

/*
 * Hover: icons baked in --icon-muted switch to --icon-default when hovered, or when the link or
 * button they sit in is hovered. Primary/blue buttons are skipped because their icons are inverse.
 */
@media (hover: hover) {
/* HOVER */
}
