{
  "name": "devportal-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && node scripts/build-spec.ts && vite build && node scripts/prerender.ts",
    "test": "vitest run",
    "roundtrip-corpus": "node scripts/roundtrip-corpus.ts",
    "golden": "vitest run src/editor/html/golden.test.ts src/editor/markdown/roundtrip.test.ts",
    "lint": "eslint . --max-warnings=0 && stylelint 'src/**/*.css' --max-warnings=0",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@readme/httpsnippet": "11.4.1",
    "@tiptap/core": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "codemirror": "^5.65.20",
    "lucide-react": "^1.55.0",
    "markdown-it": "14.1.1",
    "minisearch": "7.2.0",
    "prosemirror-markdown": "1.13.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "url": "0.11.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "28.0.3",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.1.0",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
