#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

set -e  # exit immediately if any command fails

# Compile SCSS before committing
npm run scss-compile

# Run lint-staged: Prettier + ESLint on JS/JSX, Prettier + Stylelint on SCSS
npx lint-staged

# Run Ruff on staged Python files, at the version CI uses (pinned in requirements.txt and linting.yaml).
# A ruff on PATH is used only when it is that version; otherwise uv runs the pinned one. With neither,
# the commit is refused: skipping silently lets unformatted Python through to a red CI.
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=d | grep -E '\.py$' || true)
if [ -n "$STAGED_PY_FILES" ]; then
    RUFF_VERSION=$(sed -n 's/^ruff==//p' requirements.txt | tr -d '[:space:]')
    if command -v ruff >/dev/null 2>&1 && [ "$(ruff --version | awk '{print $2}')" = "$RUFF_VERSION" ]; then
        RUFF="ruff"
    elif command -v uvx >/dev/null 2>&1; then
        RUFF="uvx ruff@$RUFF_VERSION"
    else
        echo "✖ Ruff $RUFF_VERSION is needed to lint staged Python files."
        echo "  Install uv (brew install uv) or run: pip install ruff==$RUFF_VERSION"
        echo "  To skip this once: git commit --no-verify"
        exit 1
    fi
    echo "$STAGED_PY_FILES" | xargs $RUFF check --fix
    echo "$STAGED_PY_FILES" | xargs $RUFF format
    echo "$STAGED_PY_FILES" | xargs git add
fi
