#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

set -e  # exit immediately if any command fails

# Compile SCSS before committing
npm run scss-compile

# Run lint-staged: Prettier + ESLint on JS/JSX, Prettier + Stylelint on SCSS
npx lint-staged

# Run Ruff on staged Python files (requires active Python env with ruff installed)
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=d | grep -E '\.py$' || true)
if [ -n "$STAGED_PY_FILES" ]; then
    if command -v ruff >/dev/null 2>&1; then
        echo "$STAGED_PY_FILES" | xargs ruff check --fix
        echo "$STAGED_PY_FILES" | xargs ruff format
        echo "$STAGED_PY_FILES" | xargs git add
    else
        echo "⚠️  Warning: ruff not found — Python linting skipped."
        echo "   To enable: pip install ruff (or activate your Python virtualenv)"
    fi
fi
