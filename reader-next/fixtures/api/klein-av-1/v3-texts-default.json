      "text": [
        "<strong dir=\"rtl\">אָב ᴵ</strong> m.n. (pl. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_אָבוֹת.1\" data-ref=\"Klein Dictionary, אָבוֹת 1\">אָבוֹת</a>)   <b>1</b> father.     <b>2</b> forefather, patriarch.     <b>3</b> ancestor, progenitor.     <b>4</b> head (of a family), leader, chief.     <b>5</b> God.     <b>6</b> master, teacher.     <b>7</b> important, great.   PBH  <b>8</b> parent (male).   PBH  <b>9</b> basic factor, origin, source.   NH  <b>10</b> Father (of the Christian Church).  [cp. Aram. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_אַבָּא.1\" data-ref=\"Klein Dictionary, אַבָּא 1\">אַבָּא</a>, Ugar. <i>’b</i>, Akka. <i>abu</i>, Arab. <i>abu</i>.] Derivatives: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_אַבְהוּת.1\" data-ref=\"Klein Dictionary, אַבְהוּת 1\">אַבֽהוּת</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_אַבְהִי.1\" data-ref=\"Klein Dictionary, אַבְהִי 1\">אַבְהִי</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_אָבוּת.1\" data-ref=\"Klein Dictionary, אָבוּת 1\">אָבוּת</a>."
      ]
    }
