{
  "$id": "https://www.sefaria.org/reader/contract/surface-manifest.v1.schema.json",
  "title": "Sefaria reader surface manifest, v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._+-]{1,64}$"
    },
    "contract": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:https?:\\/\\/[^\\s]+|(?!\\/\\/)(?![a-zA-Z][a-zA-Z0-9+.-]*:)[^\\s\\\\]+)$"
    },
    "integrity": {
      "type": "string",
      "pattern": "^(?:sha(?:256|384|512)-[A-Za-z0-9+/]+={0,2})(?: sha(?:256|384|512)-[A-Za-z0-9+/]+={0,2})*$"
    },
    "files": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?:https?:\\/\\/[^\\s]+|(?!\\/\\/)(?![a-zA-Z][a-zA-Z0-9+.-]*:)[^\\s\\\\]+)$"
          },
          "integrity": {
            "type": "string",
            "pattern": "^(?:sha(?:256|384|512)-[A-Za-z0-9+/]+={0,2})(?: sha(?:256|384|512)-[A-Za-z0-9+/]+={0,2})*$"
          }
        },
        "required": [
          "path",
          "integrity"
        ],
        "additionalProperties": false
      }
    },
    "css": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^(?:https?:\\/\\/[^\\s]+|(?!\\/\\/)(?![a-zA-Z][a-zA-Z0-9+.-]*:)[^\\s\\\\]+)$"
      }
    }
  },
  "required": [
    "version",
    "contract",
    "entry",
    "integrity",
    "files"
  ],
  "additionalProperties": false
}
