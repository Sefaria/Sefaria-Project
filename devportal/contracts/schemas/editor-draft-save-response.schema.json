{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developers.sefaria.org/_contracts/editor-draft-save-response.schema.json",
  "title": "Editor: saved revision",
  "description": "200 answer of a draft save and of a restore. Staff only (401 not_authenticated, 403 forbidden), CSRF required (PLAN §2.3.5, §2.11).",
  "type": "object",
  "properties": {
    "contractVersion": {
      "$ref": "common.schema.json#/$defs/contractVersion"
    },
    "page": {
      "$ref": "editor-common.schema.json#/$defs/pageSummary"
    },
    "revision": {
      "$ref": "editor-common.schema.json#/$defs/revisionSummary"
    }
  },
  "required": ["contractVersion", "page", "revision"],
  "additionalProperties": false
}
