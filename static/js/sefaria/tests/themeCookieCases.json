{
    "_comment": "Raw Cookie header / document.cookie strings and the stored theme each must yield. Shared by static/js/sefaria/tests/theme.test.js (parseThemeCookie), static/js/tests/themeHeadScript.test.js (the inline head script) and reader/tests/theme_context_test.py (Django's own cookie parser), so the three parsers cannot drift apart.",
    "cases": [
        {"cookie": "", "expected": null},
        {"cookie": "theme=dark", "expected": "dark"},
        {"cookie": "theme=light", "expected": "light"},
        {"cookie": "a=1; theme=dark; b=2", "expected": "dark"},
        {"cookie": "a=1;theme=dark;b=2", "expected": "dark"},
        {"cookie": "theme=dark;", "expected": "dark"},
        {"cookie": " theme = dark ", "expected": "dark"},
        {"cookie": "theme=\"dark\"", "expected": "dark"},
        {"cookie": "xtheme=dark", "expected": null},
        {"cookie": "xtheme=dark; theme=light", "expected": "light"},
        {"cookie": "theme=light; xtheme=dark", "expected": "light"},
        {"cookie": "themes=dark", "expected": null},
        {"cookie": "my_theme=dark; color=dark", "expected": null},
        {"cookie": "foo=a theme=dark", "expected": null},
        {"cookie": "a=b=theme=dark", "expected": null},
        {"cookie": "theme", "expected": null},
        {"cookie": "theme=", "expected": null},
        {"cookie": "theme=Dark", "expected": null},
        {"cookie": "theme=DARK", "expected": null},
        {"cookie": "theme=darkish", "expected": null},
        {"cookie": "theme=light dark", "expected": null},
        {"cookie": "theme=dark=1", "expected": null},
        {"cookie": "theme=%64ark", "expected": null},
        {"cookie": "theme=system", "expected": null},
        {"cookie": "theme=\"><script>alert(1)</script>", "expected": null},
        {"cookie": "theme=dark; theme=light", "expected": "light"},
        {"cookie": "theme=light; theme=dark", "expected": "dark"},
        {"cookie": "theme=dark; theme=garbage", "expected": null},
        {"cookie": "theme=garbage; theme=dark", "expected": "dark"}
    ]
}
