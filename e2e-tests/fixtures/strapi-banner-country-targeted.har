            "size": -1,
            "mimeType": "application/json",
            "text": "{\"data\":{\"en_banners\":[{\"documentId\":\"iv7m6otlx0wm8r42808nypl0\",\"internalBannerName\":\"2026-purim-banner-2\",\"bannerEndDate\":\"2026-08-08T17:00:00.000Z\",\"bannerStartDate\":\"2026-08-04T04:00:00.000Z\",\"bannerText\":\"A generous donor is **MATCHING** all donations this Purim, up to $36,000! Celebrate the joy of Jewish learning with a matched gift today. \",\"buttonText\":\"Double My Donation\",\"buttonURL\":\"https://donate.sefaria.org/give/451346/#!/donation/checkout?c_src=web\",\"showDelay\":1,\"bannerBackgroundColor\":\"#004E5F\",\"createdAt\":\"2026-02-11T21:05:12.668Z\",\"locale\":\"en\",\"publishedAt\":\"2026-08-06T22:58:18.580Z\",\"shouldDeployOnMobile\":true,\"showToNewVisitors\":true,\"showToNonSustainers\":true,\"showToReturningVisitors\":true,\"showToSustainers\":true,\"showTo\":\"both_logged_in_and_logged_out\",\"countriesToTarget\":{\"countryMode\":\"exclude\",\"countries\":[{\"name\":\"United States\",\"code\":\"US\"}]},\"updatedAt\":\"2026-08-06T22:58:18.574Z\"}],\"he_banners\":[{\"documentId\":\"iv7m6otlx0wm8r42808nypl0\",\"internalBannerName\":\"2026-purim-banner-2\",\"bannerEndDate\":\"2026-08-08T17:00:00.000Z\",\"bannerStartDate\":\"2026-08-04T04:00:00.000Z\",\"bannerText\":\"תורם נדיב **משווה** את כל התרומות בפורים הזה, עד 36,000 דולר! חגגו את שמחת הלימוד היהודי עם מתנה תואמת עוד היום.\",\"buttonText\":\"הכפל את התרומה שלי\",\"buttonURL\":\"https://donate.sefaria.org/give/468442/#!/donation/checkout?c_src=web\",\"showDelay\":1,\"bannerBackgroundColor\":\"#004E5F\",\"createdAt\":\"2026-08-05T08:29:15.175Z\",\"locale\":\"he\",\"publishedAt\":\"2026-08-07T00:01:27.329Z\",\"shouldDeployOnMobile\":true,\"showToNewVisitors\":true,\"showToNonSustainers\":true,\"showToReturningVisitors\":true,\"showToSustainers\":true,\"showTo\":\"both_logged_in_and_logged_out\",\"countriesToTarget\":{\"countryMode\":\"include\",\"countries\":[{\"name\":\"Israel\",\"code\":\"IL\"}]},\"updatedAt\":\"2026-08-07T00:01:27.319Z\"}],\"en_modals\":[{\"documentId\":\"pwhm4xcatmvsp7bxlvedeu4u\",\"internalModalName\":\"shavuot-2026-modal-example\",\"buttonText\":\"Donate Monthly\",\"buttonURL\":\"https://donate.sefaria.org/campaign/779365/donate?c_src=web\",\"showDelay\":1,\"createdAt\":\"2026-05-20T13:23:09.375Z\",\"locale\":\"en\",\"modalEndDate\":\"2026-08-11T03:45:00.000Z\",\"modalStartDate\":\"2026-08-04T04:45:00.000Z\",\"modalHeader\":null,\"modalText\":\"\\n“Who is wise? One who learns from every person.” – Pirkei Avot 4:1\\n\\nWe chose this verse for this year’s tote bag because it is a reminder that wisdom is available to us all. Sefaria's mission is to help you gain wisdom from the breadth of the Jewish textual tradition. We are making it possible for more people to learn Torah than perhaps at any other point in Jewish history.\\n\\nThis Shavuot, start your monthly gift to power Jewish learning and claim your free tote bag!\\n\\nUpdate: We still need **100** new monthly donors to meet our goal! Give today to give back to Sefaria.\",\"publishedAt\":\"2026-08-06T11:12:24.085Z\",\"shouldDeployOnMobile\":true,\"showToNewVisitors\":true,\"showToNonSustainers\":true,\"showToReturningVisitors\":true,\"showToSustainers\":true,\"showTo\":\"both_logged_in_and_logged_out\",\"countriesToTarget\":{\"countryMode\":\"include\",\"countries\":[{\"name\":\"United Kingdom\",\"code\":\"GB\"}]},\"updatedAt\":\"2026-08-06T11:12:24.070Z\"}],\"he_modals\":[{\"documentId\":\"pwhm4xcatmvsp7bxlvedeu4u\",\"internalModalName\":\"shavuot-2026-modal-example\",\"buttonText\":\"תן עכשיו\",\"buttonURL\":\"https://donate.sefaria.org/give/451346#!/donation/checkout?c_src=web\",\"showDelay\":1,\"createdAt\":\"2026-08-05T09:47:30.056Z\",\"locale\":\"he\",\"modalEndDate\":\"2026-08-11T03:45:00.000Z\",\"modalStartDate\":\"2026-08-04T04:45:00.000Z\",\"modalHeader\":\"Support Sefaria\",\"modalText\":\"״איזהו חכם? הלומד מכל אדם.״ — פרקי אבות ד׳, א׳\\n\\nבחרנו במשנה זו עבור תיק הבד של השנה, משום שהיא מזכירה לנו שהחוכמה זמינה לכולנו. המשימה של ספריא היא לסייע לכם לשאוב חוכמה ממלוא רוחבה של מסורת הטקסטים היהודית. אנו מאפשרים ליותר אנשים ללמוד תורה מאשר אולי בכל תקופה אחרת בהיסטוריה היהודית.\\n\\nבחג השבועות הזה, התחילו לתרום מדי חודש כדי לתמוך בלימוד יהודי, וקבלו תיק בד במתנה!\\n\\nעדכון: עדיין חסרים לנו 100 תורמים חודשיים חדשים כדי לעמוד ביעד שלנו! תרמו עוד היום והחזירו לספריא על כל מה שהיא מעניקה לכם.\",\"publishedAt\":\"2026-08-06T11:12:45.702Z\",\"shouldDeployOnMobile\":true,\"showToNewVisitors\":true,\"showToNonSustainers\":true,\"showToReturningVisitors\":true,\"showToSustainers\":true,\"showTo\":\"both_logged_in_and_logged_out\",\"countriesToTarget\":{\"countryMode\":\"all\",\"countries\":[]},\"updatedAt\":\"2026-08-06T11:12:45.695Z\"}],\"en_sidebarAds\":[{\"documentId\":\"lnc4yt9rfeklxbaynb8ef0j2\",\"buttonAboveOrBelow\":\"below\",\"title\":\"Your Letter in the Torah\",\"bodyText\":\"Claim your letter in our collaborative digital Torah scroll or dedicate one to someone you love.\",\"buttonText\":\"Get Yours Free\",\"buttonURL\":\"https://torah.sefaria.org?utm_source=site&utm_medium=sidebar&utm_campaign=socialissuestopic\",\"buttonIcon\":{\"url\":\"/uploads/collection_black_77313d4544.svg\",\"alternativeText\":\"Collection Graphic\"},\"createdAt\":\"2025-11-11T20:03:24.854Z\",\"debug\":true,\"endTime\":\"2026-08-10T06:00:00.000Z\",\"hasBlueBackground\":false,\"internalCampaignId\":\"GCT Sidebar Social Issues Topic\",\"keywords\":\"prayer, beliefs, !social-issues\",\"locale\":\"en\",\"publishedAt\":\"2026-08-06T08:48:20.373Z\",\"showTo\":\"all\",\"startTime\":\"2026-08-02T06:00:00.000Z\",\"updatedAt\":\"2026-08-06T08:48:20.366Z\",\"isNewsletterSubscriptionInputForm\":false,\"newsletterMailingLists\":[]}],\"he_sidebarAds\":[{\"documentId\":\"lnc4yt9rfeklxbaynb8ef0j2\",\"buttonAboveOrBelow\":\"below\",\"title\":\"האות שלך בתורה\",\"bodyText\":\"קבלו את האות שלכם בספר התורה הדיגיטלי השיתופי שלנו או הקדשו אחת למישהו שאתם אוהבים.\",\"buttonText\":\"קבלו את שלכם בחינם\",\"buttonURL\":\"https://torah.sefaria.org?utm_source=site&utm_medium=sidebar&utm_campaign=socialissuestopic\",\"buttonIcon\":{\"url\":\"/uploads/collection_black_77313d4544.svg\",\"alternativeText\":\"Collection Graphic\"},\"createdAt\":\"2026-08-06T08:37:52.892Z\",\"debug\":true,\"endTime\":\"2026-08-10T06:00:00.000Z\",\"hasBlueBackground\":false,\"internalCampaignId\":\"GCT Sidebar Social Issues Topic\",\"keywords\":\"prayer, beliefs, !social-issues\",\"locale\":\"he\",\"publishedAt\":\"2026-08-06T08:38:54.817Z\",\"showTo\":\"all\",\"startTime\":\"2026-08-02T06:00:00.000Z\",\"updatedAt\":\"2026-08-06T08:38:54.808Z\",\"isNewsletterSubscriptionInputForm\":false,\"newsletterMailingLists\":[]}]}}\n"
